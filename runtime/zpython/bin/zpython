#!/bin/bash
# Portable ZOO launcher. Runtime locations come only from an explicit profile.

set -u
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
launcher_root=$(cd -- "$script_dir/.." && pwd)
profile_name=${ZOO_RUNTIME_PROFILE:-}
config_override=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      [[ $# -ge 2 ]] || { echo "--profile requires a name" >&2; exit 2; }
      profile_name=$2
      shift 2
      ;;
    --config)
      [[ $# -ge 2 ]] || { echo "--config requires a directory" >&2; exit 2; }
      config_override=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ -z "$profile_name" ]]; then
  echo "Select a runtime profile with --profile NAME or ZOO_RUNTIME_PROFILE" >&2
  exit 2
fi
if [[ ! "$profile_name" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  echo "Invalid runtime profile name: $profile_name" >&2
  exit 2
fi

profile_path="$launcher_root/profiles/$profile_name.conf"
if [[ ! -f "$profile_path" ]]; then
  echo "Runtime profile does not exist: $profile_path" >&2
  exit 2
fi
source "$profile_path"

: "${ZOO_BASE_PYTHON:?profile must define ZOO_BASE_PYTHON}"
: "${KUNPY_ROOT:?profile must define KUNPY_ROOT}"
: "${ZOO_ROOT:?profile must define ZOO_ROOT}"

if [[ ! -x "$ZOO_BASE_PYTHON" ]]; then
  echo "Base Python is not executable: $ZOO_BASE_PYTHON" >&2
  exit 2
fi
if [[ ! -d "$KUNPY_ROOT/Libs" ]]; then
  echo "kunpy Libs directory does not exist: $KUNPY_ROOT/Libs" >&2
  exit 2
fi
if [[ ! -d "$ZOO_ROOT/Libs" ]]; then
  echo "ZOO Libs directory does not exist: $ZOO_ROOT/Libs" >&2
  exit 2
fi

if [[ -n "$config_override" ]]; then
  ZOOCONFIGPATH=$config_override
fi
if [[ -n "${ZOOCONFIGPATH:-}" && ! -f "$ZOOCONFIGPATH/beamline.ini" ]]; then
  echo "beamline.ini does not exist in: $ZOOCONFIGPATH" >&2
  exit 2
fi

if [[ -n "${QB_PYTHONPATH:-}" ]]; then
  export QB_PYTHONPATH="$ZOO_ROOT:$ZOO_ROOT/Libs:$KUNPY_ROOT:$KUNPY_ROOT/Libs:$QB_PYTHONPATH"
else
  export QB_PYTHONPATH="$ZOO_ROOT:$ZOO_ROOT/Libs:$KUNPY_ROOT:$KUNPY_ROOT/Libs"
fi

export ZOO_RUNTIME_PROFILE="$profile_name"
export KUNPY_ROOT ZOO_ROOT
if [[ -n "${ZOOCONFIGPATH:-}" ]]; then
  export ZOOCONFIGPATH
fi
exec "$ZOO_BASE_PYTHON" "$@"
