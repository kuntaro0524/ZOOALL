#!/bin/bash
# Compatibility helper: PROFILE CONFIG_DIR PYTHON_ARGS...

if [[ $# -lt 3 ]]; then
  echo "Usage: zpython-with-config PROFILE CONFIG_DIR PYTHON_ARGS..." >&2
  exit 2
fi

profile_name=$1
config_dir=$2
shift 2
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec "$script_dir/zpython" --profile "$profile_name" --config "$config_dir" "$@"
